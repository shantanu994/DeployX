# Server listening port (Render injects PORT automatically)
PORT=3000

# Runtime environment (development | production | test)
NODE_ENV=development

# Allowed frontend origin(s), comma-separated (e.g. https://deployx-frontend.onrender.com)
CORS_ORIGIN=http://localhost:5173

# Secret configured in GitHub repository Webhook settings (X-Hub-Signature-256)
GITHUB_WEBHOOK_SECRET=

# Secret used to sign HS256 JWT tokens for /api/auth/*
JWT_SECRET=

# Optional path to JSON file for MVP persistence (leave blank for in-memory)
DATA_FILE=
